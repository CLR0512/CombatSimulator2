    <Compile Include="../src/Common/Links.cs" Link="Common/Links.cs" />
    <PackageReference Include="xunit.v3" />
    <!-- Syntax only: the layer test reads the mod's sources as text. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <!-- Tests read the mod's sources and their own fixtures, wherever the test exe is built. -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ModFolder</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/..'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
